PORT=8787
HOST=127.0.0.1

# Trust exactly one reverse proxy (Caddy in the Docker deployment).
TRUST_PROXY=0

# Shared password for trusted LAN users. Leave blank only for loopback development.
LAN_ACCESS_TOKEN=

# Maximum simultaneous provider/ffmpeg render or retouch jobs.
MAX_CONCURRENT_RENDERS=1

# Optional absolute path to a system ffmpeg executable.
FFMPEG_PATH=

# Optional OpenAI-compatible chat completion endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Optional direct DeepSeek planner. Preferred over the Ark text model when set.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Optional video provider adapter. The local fallback renderer works without it.
VIDEO_PROVIDER_URL=
VIDEO_PROVIDER_API_KEY=

# Native Volcengine Ark async video provider.
ARK_API_KEY=
ARK_VIDEO_MODEL=doubao-seedance-2-0-mini-260615
ARK_TEXT_MODEL=doubao-seed-2-1-pro-260628
ARK_MAX_GENERATED_SHOTS=3

# Public origin that exposes /materials to Seedance, for example an HTTPS tunnel or object-storage proxy.
# Without this, local image/video materials can still use exact overlay, but not AI reference/first-frame modes.
MATERIAL_PUBLIC_BASE_URL=
OUTPUT_PUBLIC_BASE_URL=

# Extra exact DNS hostnames allowed for personal OpenAI-compatible HTTPS endpoints.
PERSONAL_API_ALLOWED_HOSTS=
