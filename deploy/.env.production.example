# Copy this file to deploy/.env.production, set mode 0600, and replace every sample value.
APP_IMAGE=science-video-workbench
APP_VERSION=local

# Stable LAN DNS name or IP served by Caddy's private CA.
LAN_HOST=science-video.lan
HTTP_PORT=80
HTTPS_PORT=443

# Use absolute Linux paths outside a user's home directory.
DATA_DIR=/srv/science-video-workbench/data
BACKUP_DIR=/srv/science-video-workbench/backups
# Optional second disk, NAS, or removable-media mount. Leave blank to disable mirroring.
BACKUP_MIRROR_DIR=
BACKUP_RETENTION_DAYS=14

# At least 16 characters. Generate a unique value before deployment.
LAN_ACCESS_TOKEN=replace-with-a-long-random-password
TRUST_PROXY=1
MAX_CONCURRENT_RENDERS=1

# Optional server-wide fallbacks. Users may instead enter personal keys in their browser session.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
VIDEO_PROVIDER_URL=
VIDEO_PROVIDER_API_KEY=
ARK_API_KEY=
ARK_VIDEO_MODEL=doubao-seedance-2-0-mini-260615
ARK_TEXT_MODEL=doubao-seed-2-1-pro-260628
ARK_MAX_GENERATED_SHOTS=3

# External providers cannot fetch RFC1918/private LAN URLs. Set these only to a public HTTPS origin.
MATERIAL_PUBLIC_BASE_URL=
OUTPUT_PUBLIC_BASE_URL=
